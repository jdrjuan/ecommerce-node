    <h1>{{pageTitle}}</h1>
    
    {{#if successMessage}}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            <h2><i class="bi bi-check-circle"></i> {{successMessage}}</h2>
            <hr>
            {{#with createdProduct}}
                <p>Nombre: {{name}}</p>
                <p>Precio: {{price}}</p>
                <p>Stock: {{stock}}</p>
                <p>Marca: {{brand}}</p>
                <p>Categoría: {{category}}</p>
                <p>Descripción corta: {{shortDescription}}</p>
                <p>Descripción larga: {{longDescription}}</p>
                <p>Envío gratis: {{getFreeShippingText}}</p>
                {{#if mainPhoto}}
                    <img src="{{mainPhoto}}" alt="{{name}}">
                {{else}}
                    <p>No se cargó ninguna foto para este producto.</p>
                {{/if}}
            {{/with}}
        </div>
    {{/if}}

    <form action="/product-create" method="post" autocomplete="off">

        <div class="mb-3">
            <label for="name" class="form-label">Nombre</label>
            <input type="text" class="form-control" id="name" name="name" placeholder="Ej: TV" autofocus>
        </div>

        <div class="mb-3">
            <label for="price" class="form-label">Precio</label>
            <input type="text" class="form-control" id="price" name="price" placeholder="Ej: 2000">
        </div>

        <div class="mb-3">
            <label for="stock" class="form-label">Stock</label>
            <input type="text" class="form-control" id="stock" name="stock" placeholder="Ej: 20">
        </div>

        <div class="mb-3">
            <label for="brand" class="form-label">Marca</label>
            <input type="text" class="form-control" id="brand" name="brand" placeholder="Ej: Sony">
        </div>

        <div class="mb-3">
            <label for="category" class="form-label">Categoría</label>
            <input type="text" class="form-control" id="category" name="category" placeholder="Ej: Smartphones">
        </div>

        <div class="mb-3">
            <label for="shortDescription" class="form-label">Descripción corta</label>
            <input type="text" class="form-control" id="shortDescription" name="shortDescription" placeholder="Ej: TV OLED de 65 pulgadas 4k">
        </div>

        <div class="mb-3">
            <label for="longDescription" class="form-label">Descripción larga</label>
            <textarea class="form-control" id="longDescription" name="longDescription" rows="3" placeholder="Ej: TV OLED de 65 pulgadas 4k con Android TV y panel de 120Hz"></textarea>
        </div>

        <div class="mb-3">
            <label for="mainPhoto" class="form-label">Foto</label>
            <input type="text" class="form-control" id="mainPhoto" name="mainPhoto" placeholder="Ej: https://servidor.com/imagenes/tv.jpg">
        </div>

        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="freeShipping" name="freeShipping">
            <label class="form-check-label" for="freeShipping">
                Envío gratis
            </label>
        </div>

        <input class="btn btn-primary" type="submit" value="Enviar">
        
    </form>
