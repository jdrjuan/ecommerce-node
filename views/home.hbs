<h1>Productos</h1>

{{pageTitle}}

<div class="row gx-3 gy-4">
    {{#each products}}
        <article class="product-card col-sm-6 col-lg-4 col-xxl-3" title="{{name}}">
            <div class="product-card__container card h-100 text-bg-dark border-secondary shadow rounded-bottom-0">

                {{#if mainPhoto}}
                    <img src="{{mainPhoto}}" class="product-card__image card-img-top" alt="{{brand}} {{name}}" />
                {{else}}
                    <img
                        src="/img/products/no-pic.jpg"
                        class="product-card__image card-img-top"
                        alt="{{brand}} {{name}}"
                    />
                {{/if}}

                <div class="product-card__body card-body d-flex flex-column">
                    <span class="product-card__brand text-uppercase small">{{brand}}</span>
                    <h2 class="product-card__title card-title fs-3 fw-lighter mt-1 mb-4">
                        {{name}}
                    </h2>
                    <p class="product-card__description card-text">{{category}}</p>
                    <p class="product-card__description card-text">
                        {{shortDescription}}
                        <a class="text-light" href="/product-info/{{id}}">Ver más...</a>
                    </p>
                    <p class="product-card__description card-text">
                        Envío sin cargo: {{getFreeShippingText}}
                    </p>
                    <p class="product-card__price card-text text-center mt-auto fs-4">
                        ${{price}}
                    </p>
                    <p class="product-card__description card-text text-center p-2">
                        {{#if stock}}
                            {{stock}} unidades
                        {{else}}
                            (sin stock)
                        {{/if}}
                    </p>
                </div>
            </div>
        </article>
    {{/each}}
</div>